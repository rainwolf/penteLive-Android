<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingBottom="10dp"
    android:paddingTop="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:gravity="center_vertical"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="@string/game"
        android:textStyle="bold"
        android:id="@+id/gameLabel"
        android:layout_alignParentStart="true" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:gravity="center_vertical|center_horizontal"
        android:clickable="true"
        android:layout_toEndOf="@id/gameLabel"
        android:textAlignment="center"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Pente"
        android:id="@+id/gameChoice"
        android:layout_alignParentEnd="true" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:gravity="center_vertical"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="@string/difficulty"
        android:textStyle="bold"
        android:id="@+id/difficultyLabel"
        android:layout_below="@id/gameLabel"
        android:layout_alignParentStart="true" />
    <androidx.appcompat.widget.AppCompatSpinner
        android:spinnerMode="dialog"
        android:id="@+id/difficultySpinner"
        android:layout_toEndOf="@id/difficultyLabel"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:layout_width="match_parent"
        android:layout_below="@id/gameChoice"
        android:textAlignment="center"
        android:layout_height="45dp"
        android:gravity="center_vertical|center_horizontal">
    </androidx.appcompat.widget.AppCompatSpinner>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:gravity="center_vertical"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="@string/play_as"
        android:textStyle="bold"
        android:id="@+id/playAsLabel"
        android:layout_below="@id/difficultyLabel"
        android:layout_alignParentStart="true" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:gravity="center_vertical|center_horizontal"
        android:clickable="true"
        android:layout_toEndOf="@id/playAsLabel"
        android:textAlignment="center"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:layout_below="@id/difficultyLabel"
        android:id="@+id/playAsChoice"
        android:layout_alignParentEnd="true" />

</RelativeLayout>