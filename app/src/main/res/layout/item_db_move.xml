<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/moveDot"
        android:layout_width="14dp"
        android:layout_height="14dp" />

    <TextView
        android:id="@+id/moveLabel"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/db_ink"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_weight="1"
        android:background="@color/db_divider"
        android:orientation="horizontal"
        android:weightSum="100">
        <View
            android:id="@+id/moveBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/db_accent" />
    </LinearLayout>

    <TextView
        android:id="@+id/movePct"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/db_ink" />

    <TextView
        android:id="@+id/moveGames"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/db_secondary_text" />
</LinearLayout>
