<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context="be.submanifold.pentelive.MMAIActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dbScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="120dp">
    <LinearLayout
        android:id="@+id/dbContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>
    <view
        class="be.submanifold.pentelive.DBBoardView"
        android:id="@+id/boardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/submitLayout"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:contentDescription="@string/nav_back"
            android:drawableStart="@drawable/ic_skip_previous"
            android:drawableTint="?android:attr/textColorPrimary"
            android:textStyle="bold" />
        <Button
            android:layout_width="0dp"
            android:layout_weight="2"
            android:visibility="gone"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/computer"
            android:focusable="false"
            android:text="@string/ask_ai"
            android:textStyle="bold"
            android:id="@+id/aiButton" />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_gravity="center"
            android:gravity="center"
            android:foregroundGravity="center"
            android:focusable="false"
            android:textStyle="bold"
            android:id="@+id/capturesView" />
        <Button
            android:id="@+id/forwardButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:contentDescription="@string/nav_forward"
            android:drawableEnd="@drawable/ic_skip_next"
            android:drawableTint="?android:attr/textColorPrimary"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dbFilterChip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/db_filters_active">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_filter_list"
            app:tint="?android:attr/textColorSecondary" />
        <TextView
            android:id="@+id/dbFilterText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:id="@+id/playerInfo"
        android:layout_marginLeft="5dp"
        android:gravity="top"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="3dp"
        android:scrollbars="vertical"
        android:enabled="true"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textSize="16sp"
        android:layout_height="wrap_content" />

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:alpha="0.5"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/dbSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxWidth="640dp"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:theme="@style/ThemeOverlay.AppCompat.DayNight"
        android:background="@color/db_sheet_background"
        android:elevation="8dp"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.5"
        app:behavior_hideable="false"
        app:behavior_peekHeight="120dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@color/db_divider" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/dbTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabTextColor="@color/db_secondary_text"
            app:tabSelectedTextColor="@color/db_accent"
            app:tabIndicatorColor="@color/db_accent" />

        <LinearLayout
            android:id="@+id/dbShowRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/db_show_n_moves"
                android:textColor="@color/db_secondary_text" />
            <Spinner
                android:id="@+id/dbShowSpinner"
                android:layout_width="wrap_content"
                android:layout_height="48dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dbSortRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/db_sort_label"
                android:textColor="@color/db_secondary_text" />
            <RadioGroup
                android:id="@+id/dbSortGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/dbSortWinpct"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/db_sort_winpct"
                    android:textColor="@color/db_ink" />
                <RadioButton
                    android:id="@+id/dbSortPopularity"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/db_sort_popularity"
                    android:textColor="@color/db_ink" />
            </RadioGroup>
            <ImageButton
                android:id="@+id/dbSortInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/db_sort_info_description"
                android:src="@drawable/ic_info_outline" />
        </LinearLayout>

        <TextView
            android:id="@+id/dbStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textColor="@color/db_secondary_text"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dbMovesList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
