# Copy to fastlane/.env (git-ignored) and fill in. Keep the key and the keystore outside the repo.

# Google Play service account key (JSON). One-time setup:
# 1. Google Cloud console (any project): IAM & Admin > Service accounts > Create service account
#    (no roles needed), then Keys > Add key > Create new key > JSON; download it once.
# 2. Enable the "Google Play Android Developer API" for that Cloud project.
# 3. Play Console > Users and permissions > Invite new users: the service account's e-mail address,
#    app access for penteLive with "Release to production, exclude devices, and use Play App Signing"
#    (plus "View app information").
# Absolute path to the .json key.
PLAY_JSON_KEY_PATH=/Users/you/.google-play/pentelive-service-account.json

# Upload keystore that signs the .aab (the upload key registered with Play App Signing).
ANDROID_KEYSTORE_PATH=/Users/you/.android-keys/pentelive-upload.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
